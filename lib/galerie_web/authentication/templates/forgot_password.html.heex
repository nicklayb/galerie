<.container>
  <.form :let={f} for={@changeset} action={~p(/forgot_password)} as={:forgot_password_form}>
    <Form.text_input field={f[:email]} autocomplete="off">
      <:label><%= gettext("Email") %></:label>
    </Form.text_input>

    <div class="text-right flex flex-col text-sm">
      <a href="/" class="pb-1"><%= gettext("Return to login") %></a>
    </div>

    <div class="text-right mt-1">
      <Form.button type={:submit}>Reset password</Form.button>
    </div>
  </.form>
</.container>
