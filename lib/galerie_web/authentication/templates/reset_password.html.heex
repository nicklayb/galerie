<.container>
  <.form :let={f} for={@changeset} action={~p(/reset_password?#{[token: @reset_password_token]})} as={:reset_password_form}>
    <Form.text_input field={f[:password]} type="password">
      <:label><%= gettext("Password") %></:label>
    </Form.text_input>
    <Form.text_input field={f[:password_confirmation]} type="password">
      <:label><%= gettext("Password confirmation") %></:label>
    </Form.text_input>

    <div class="text-right mt-1">
      <Form.button type={:submit}>Reset password</Form.button>
    </div>
  </.form>
</.container>
